APP_NAME=Flutter Live Server
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# SRS/ZLMediaKit 所在机器的局域网地址；手机 A 推流、手机 B 播放都必须可达。
MEDIA_SERVER_HOST=192.168.0.111
MEDIA_RTMP_PORT=1935
MEDIA_HTTP_PORT=8080
MEDIA_APP=live

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=flutter_live

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OSS 密钥仅配置在后端，禁止写入 Flutter；使用仅授权此 Bucket/flutter/* 的 RAM 用户。
OSS_REGION=oss-cn-shenzhen
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_BUCKET=doc-converter-pdf
OSS_PDF_DIR=pdf
OSS_RESULT_DIR=result
OSS_SOURCE_DIR=source
OSS_SIGN_EXPIRE=900
OSS_USE_SIGNED_URL=true
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 可选 JSON 覆盖各分类字节上限（须包含所有使用的分类）：
# OSS_MAX_SIZES={"avatar":10485760,"image":20971520,"pdf":52428800,"document":52428800,"audio":104857600,"video":524288000,"source":524288000,"result":524288000}
