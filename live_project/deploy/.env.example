APP_NAME=Flutter Live Server
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# FastAPI -> SRS 使用 Docker 内部网络；手机使用下面的公网 IP 和端口。
MEDIA_SERVER_HOST=120.79.144.54
MEDIA_SERVER_INTERNAL_HOST=srs
MEDIA_RTMP_PORT=11935
MEDIA_HTTP_PORT=18081
MEDIA_API_PORT=1985
MEDIA_INTERNAL_API_PORT=1985
MEDIA_PUBLIC_HOST=120.79.144.54
MEDIA_PUBLIC_RTMP_PORT=11935
MEDIA_PUBLIC_HLS_BASE_URL=http://120.79.144.54:18081
MEDIA_APP=live
LIVE_ROOM_RECONCILIATION_GRACE_SECONDS=15

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=flutter_live
MYSQL_PASSWORD=replace-with-a-random-password
MYSQL_DATABASE=flutter_live_prod

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password
SRS_CANDIDATE=120.79.144.54

# 仅注入 FastAPI 容器，不进入 Flutter 构建参数。
OSS_REGION=oss-cn-shenzhen
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_BUCKET=doc-converter-pdf
OSS_PDF_DIR=pdf
OSS_RESULT_DIR=result
OSS_SOURCE_DIR=source
OSS_SIGN_EXPIRE=900
OSS_USE_SIGNED_URL=true
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
